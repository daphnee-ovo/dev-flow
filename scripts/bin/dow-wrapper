#!/bin/sh
# dow 平台分发 wrapper — 自动选择对应平台的二进制
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"

case "${OS}_${ARCH}" in
  linux_x86_64)    BINARY="dow-linux-x86_64" ;;
  linux_aarch64)   BINARY="dow-linux-aarch64" ;;
  darwin_arm64)    BINARY="dow-darwin-arm64" ;;
  darwin_x86_64)   BINARY="dow-darwin-x86_64" ;;
  *)               echo "[dow] unsupported platform: ${OS}_${ARCH}" >&2; exit 1 ;;
esac

if [ ! -f "$SELF_DIR/$BINARY" ]; then
  echo "[dow] binary not found: $SELF_DIR/$BINARY" >&2
  echo "[dow] run 'bash dow/build.sh' to compile for this platform" >&2
  exit 1
fi

exec "$SELF_DIR/$BINARY" "$@"
