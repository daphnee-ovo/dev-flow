{
  "description": "Dev-flow project lifecycle hooks for Codex plugins",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/bin/dow hooks context -H",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/bin/dow hooks guard ${TOOL_INPUT_FILE_PATH}",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/bin/dow hooks guard ${TOOL_INPUT_FILE_PATH}",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/bin/dow hooks post-write ${TOOL_INPUT_FILE_PATH}",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/bin/dow hooks save-changelog",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
